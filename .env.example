# Live mode requires BOTH values. With neither, the app uses sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail uses OAuth, never a Gmail API key. Connect a company-owned mailbox.
# Request gmail.send only. Inbox ingestion needs a separate reviewed scope/configuration.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Optional human-reviewed offer drafts. No financial auto-posting uses AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
